{
  "auth": {
    "providers": {
      "emailPassword": true,
      "phone": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "CampusNotify",
        "supportEmail": "admin@campusnotify.edu"
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "src/**",
      "*.bat",
      "*.py",
      "test_*.js",
      "*.docx",
      "*.pdf",
      "*.zip",
      "*.md"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
