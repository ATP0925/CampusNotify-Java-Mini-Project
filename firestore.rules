rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'atpadkarmaruti@gmail.com' ||
        get(/databases/$(database)/documents/cnms_users/$(request.auth.uid)).data.role == 'ADMIN'
      );
    }

    function isAuthorizedPublisher() {
      return isAuthenticated() && (
        isAdmin() ||
        get(/databases/$(database)/documents/cnms_users/$(request.auth.uid)).data.canPost == true
      );
    }

    // Official Notices Collection
    match /cnms_notices/{noticeId} {
      // Anyone on campus can view circulars
      allow read: if true;
      
      // Only Admin or Admin-authorized publishers can create or modify notices
      allow create, update: if isAuthorizedPublisher();
      
      // Only Admin can delete notices
      allow delete: if isAdmin();
    }

    // Campus User Profiles Collection
    match /cnms_users/{userId} {
      // Users can read campus profiles
      allow read: if true;
      
      // Users can update their own bio; Admin can update roles and approvals
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // Registration: User can create their account (status: pending_approval)
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // Only Admin can delete user accounts
      allow delete: if isAdmin();
    }

    // Campus Community Lounge Messages & Shared Files
    match /cnms_community_messages/{messageId} {
      // All verified campus members can read messages and shared files
      allow read: if true;
      
      // Any authenticated approved member can post messages or share files
      allow create: if isAuthenticated();
      
      // Only Admin or original author can delete messages
      allow delete: if isAuthenticated() && (isAdmin() || request.auth.uid == resource.data.authorId);
    }
  }
}
